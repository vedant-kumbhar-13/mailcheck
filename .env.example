# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# CORS — your frontend origin
ALLOW_ORIGINS=http://localhost:5173

# Abstract API — SMTP deliverability check (optional but recommended)
# Free tier: 100 checks/month. No credit card.
# How to get your key:
#   1. Go to https://app.abstractapi.com/users/signup
#   2. Sign up for free
#   3. Click "My APIs" → "Email Validation"
#   4. Copy the API key shown on the dashboard
# Leave empty to run in DNS-only mode (syntax + MX check, no SMTP confirmation).
ABSTRACT_API_KEY=

# CSV limits
MAX_CSV_BYTES=2097152
MAX_CSV_ROWS=1000

# DNS
DNS_TIMEOUT_SECONDS=3
